// suggest型资源站：搜索不支持 ac=videolist&wd=，改走联想接口（来自 88lin/video_vip 的无损云直连方案）
export class SuggestSource {
	key : string = ""
	suggestApi : string = ""
	constructor(key : string = "", suggestApi : string = "") {
		this.key = key
		this.suggestApi = suggestApi
	}
}

export const SUGGEST_SOURCES : Array<SuggestSource> = [
	new SuggestSource('wsyzy', 'https://wsyzy.cc/index.php/ajax/suggest')
]

