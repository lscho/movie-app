// 苹CMS play_from 标识 → 展示名
export function flagLabel(flag : string) : string {
	if (flag.indexOf('m3u8') >= 0) return 'm3u8线路'
	if (flag == '360zy') return '360线路'
	if (flag == 'ffm3u8' || flag == 'feifan') return '非凡线路'
	if (flag == 'bfzym3u8') return '暴风线路'
	if (flag == 'lzm3u8') return '量子线路'
	if (flag == 'wsym3u8') return '无损云线路'
	return flag
}

// 判断字符串是否为视频平台网址（走解析通道）
export function isVideoSiteUrl(text : string) : boolean {
	const t = text.trim().toLowerCase()
	if (t.indexOf('http://') != 0 && t.indexOf('https://') != 0) return false
	const hosts = ['v.qq.com', 'www.iqiyi.com', 'iqiyi.com', 'www.youku.com', 'v.youku.com',
		'www.mgtv.com', 'mgtv.com', 'www.bilibili.com', 'bilibili.com', 'tv.sohu.com',
		'www.1905.com', '1905.com', 'pptv.com', 'v.pptv.com', 'www.wasu.cn', 'le.com',
		'tudou.com', 'acfun.cn']
	for (let i = 0; i < hosts.length; i++) {
		if (t.indexOf(hosts[i]) >= 0) return true
	}
	// 兜底：任意 http 链接也允许解析
	return true
}
