	}

	.player-video-empty {
		align-items: center;
		justify-content: center;
	}

	.player-panel {
		flex: 1;
		padding: 24rpx 32rpx;
	}

	.player-info-tags {
		margin-top: 16rpx;
	}

	.player-info-tag {
		margin-right: 12rpx;
	}

	.player-src-label {
		margin-left: 8rpx;
	}

	.player-error {
		margin-top: 24rpx;
		padding: 20rpx;
		border-radius: 16rpx;
		background-color: #33202a;
	}

	.player-error-actions {
		margin-top: 16rpx;
	}

	.player-sec-title {
		margin-bottom: 20rpx;
	}

	.player-episodes {
		margin-top: 12rpx;
	}

	.player-sources {
		margin-top: 12rpx;
	}

	.player-bottom-space {
		height: 80rpx;
	}

	/* ---------- 投屏遥控面板 ---------- */
	.cast-remote {
		margin-top: 12rpx;
		padding: 24rpx;
		border-radius: 20rpx;
		background-color: #1a1c22;
	}

	.cast-remote-actions {
		margin-bottom: 4rpx;
	}

	.cast-remote-row {
		margin-top: 12rpx;
	}

	.cast-remote-label {
		width: 72rpx;
	}

	.cast-remote-slider-box {
		flex: 1;
		margin: 0 16rpx;
	}

	.cast-remote-time {
		width: 168rpx;
		text-align: right;
	}

	.cast-slider {
		width: 100%;
	}

	.cast-slider-track {
		background-color: #262b36;
