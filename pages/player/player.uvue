<template>
	<view class="player-page">
		<!-- 状态栏占位 + 顶部导航 -->
		<view class="status-bar" :style="{ height: statusBarH + 'px' }"></view>
		<view class="player-topbar row">
			<view class="player-back" hover-class="focusable-hover" @click="goBack">
				<text class="player-back-icon">‹</text>
			</view>
			<view class="flex1 player-title-box">
				<text class="t-white player-title">{{vodName}}</text>
				<text class="t-sub player-sub" v-if="curEpName.length > 0">{{curEpName}} · {{curSrcLabel}}</text>
			</view>
			<!-- 投屏：始终显示，投屏中高亮 -->
			<view :class="casting ? 'player-cast player-cast-active' : 'player-cast'" hover-class="chip-hover"
				@click="openCastPanel">
				<text :class="casting ? 't-accent' : 't-sub'">{{casting ? '投屏中' : '投屏'}}</text>
			</view>
			<view class="player-switch" hover-class="chip-hover" @click="switchNextSource" v-if="sources.length > 1">
				<text class="t-accent">换源</text>
			</view>
			<view class="player-switch-placeholder" v-else></view>
		</view>

		<!-- 投屏状态卡片：视频区域上方，常驻显示投屏进度 -->
		<view class="player-cast-card" v-if="casting">
			<view class="row player-cast-card-top">
				<view class="player-cast-dot"></view>
				<text class="t-accent player-cast-card-title flex1">正在投屏到 {{castDeviceName}}</text>
				<text class="t-dim">{{castProgressText}}</text>
			</view>
			<text class="cast-ended-tip" v-if="castEnded">本集已播完，请回手机选择下一集</text>
		</view>

		<!-- 播放器：拿到真实地址后才创建组件，避免空src初始化与早赋值竞态 -->
		<view class="player-video player-video-empty" v-if="playUrl.length == 0">
			<text class="t-dim">加载中…</text>
		</view>
		<video id="player" class="player-video" v-if="playUrl.length > 0" :src="playUrl" autoplay controls
			:poster="vodPic" object-fit="contain" show-center-play-btn
			@timeupdate="onTimeUpdate" @ended="onEnded" @error="onError" @loadedmetadata="onLoaded"
			@play="onPlay">
		</video>

		<!-- 信息与选集 -->
		<scroll-view class="player-panel" direction="vertical">
			<view class="player-info card">
				<text class="t-title">{{vodName}}</text>
				<view class="row player-info-tags">
					<text class="tag-accent player-info-tag" v-if="remark.length > 0">{{remark}}</text>
					<text class="tag player-info-tag" v-if="typeName.length > 0">{{typeName}}</text>
					<text class="t-dim player-src-label">线路：{{curSrcLabel}}</text>
				</view>

				<!-- 错误提示 -->
				<view class="player-error" v-if="playError">
					<text class="t-sub">播放失败{{playErrMsg.length > 0 ? `（${playErrMsg}）` : ''}}，可能是该线路失效</text>
					<view class="row player-error-actions">
						<view class="chip" hover-class="chip-hover" @click="switchNextSource">
							<text class="t-accent">换线路重试</text>
						</view>
						<view class="chip" hover-class="chip-hover" @click="goBack">
							<text class="t-sub">返回选集</text>
						</view>
					</view>
				</view>
			</view>

			<!-- 投屏遥控面板：剧集列表上方 -->
			<view class="cast-remote" v-if="casting">
				<text class="t-main player-sec-title">投屏遥控</text>
				<view class="wrap cast-remote-actions">
					<view class="chip" hover-class="chip-hover" @click="castTogglePlay">
						<text class="t-accent">{{castPlayLabel}}</text>
					</view>
					<view class="chip" hover-class="chip-hover" @click="castSeekBack">
						<text class="t-sub">快退10s</text>
					</view>
					<view class="chip" hover-class="chip-hover" @click="castSeekForward">
						<text class="t-sub">快进10s</text>
					</view>
					<view class="chip" hover-class="chip-hover" @click="stopCasting">
						<text class="t-sub">停止投屏</text>
					</view>
				</view>
				<view class="row cast-remote-row">
					<text class="t-dim cast-remote-label">进度</text>
					<view class="flex1 cast-remote-slider-box">
						<slider class="cast-slider" :value="castSliderPos" :min="0" :max="castSliderMax" :step="1"
							track-class="cast-slider-track" track-active-class="cast-slider-track-active"
							thumb-class="cast-slider-thumb" @changing="onCastProgressChanging"
							@change="onCastProgressChange"></slider>
					</view>
					<text class="t-dim cast-remote-time">{{castProgressText}}</text>
				</view>
				<view class="row cast-remote-row">
					<text class="t-dim cast-remote-label">音量</text>
					<view class="flex1 cast-remote-slider-box">
						<slider class="cast-slider" :value="castVolume" :min="0" :max="100" :step="1"
							track-class="cast-slider-track" track-active-class="cast-slider-track-active"
							thumb-class="cast-slider-thumb" @changing="onCastVolumeChanging"
							@change="onCastVolumeChange"></slider>
					</view>
					<text class="t-dim cast-remote-time">{{castVolume}}</text>
				</view>
			</view>

			<!-- 剧集 -->
			<view class="player-episodes" v-if="episodes.length > 0">
				<text class="t-main player-sec-title">选集（{{episodes.length}}）</text>
				<view class="ep-grid">
					<view :class="epIdx == i ? 'ep-grid-item-active' : 'ep-grid-item'" v-for="(ep, i) in episodes"
						:key="i" hover-class="ep-hover" @click="switchEp(i)">
						<text :class="epIdx == i ? 'ep-grid-text-active' : 'ep-grid-text'">{{ep.name}}</text>
					</view>
				</view>
			</view>

			<!-- 线路 -->
			<view class="player-sources" v-if="sources.length > 1">
				<text class="t-main player-sec-title">线路</text>
				<view class="wrap">
					<view :class="srcIdx == i ? 'chip-active' : 'chip'" v-for="(s, i) in sources" :key="i"
						hover-class="chip-hover" @click="switchSource(i)">
						<text :class="srcIdx == i ? 't-accent' : 't-sub'">{{s.label}}（{{s.episodes.length}}集）</text>
					</view>
				</view>
			</view>
			<view class="player-bottom-space"></view>
		</scroll-view>

		<!-- 投屏设备选择弹层（底部浮出，静态显示无动画） -->
		<view class="cast-layer" v-if="showCastPanel">
			<view class="cast-mask" @click="closeCastPanel"></view>
			<view class="cast-panel">
				<text class="t-main cast-panel-title">选择投屏设备</text>
				<view class="cast-panel-body">
					<text class="t-sub cast-scan-tip" v-if="scanning">正在搜索局域网设备…</text>
					<view class="cast-empty" v-if="!scanning && castDevices.length == 0">
						<text class="t-main">未找到设备</text>
						<text class="t-dim cast-empty-tip">{{scanHint}}</text>
						<text class="t-dim cast-diag" v-if="scanDiag.length > 0" @click="copyDiag">诊断：{{scanDiag}}</text>
						<view class="btn-ghost cast-retry" hover-class="btn-ghost-hover" @click="startScan">
							<text class="t-accent">重新搜索</text>
						</view>
					</view>
					<scroll-view class="cast-panel-list" direction="vertical" v-if="castDevices.length > 0">
						<view class="cast-device" v-for="d in castDevices" :key="d.udn" hover-class="chip-hover"
							@click="pickDevice(d)">
							<text class="cast-device-name flex1">{{d.name}}</text>
							<text class="t-accent">连接</text>
						</view>
					</scroll-view>
					<text class="t-dim cast-connecting" v-if="connecting">正在连接设备…</text>
				</view>
				<view class="btn-ghost cast-cancel" hover-class="btn-ghost-hover" @click="closeCastPanel">
					<text class="t-sub">取消</text>
				</view>
			</view>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { VodItem, PlaySource, Episode } from '../../types/model.uts'
	import { HistoryItem } from '../../types/model.uts'

	import { fetchVod } from '../../api/vod.uts'
	import { pushHistory, saveProgress, getProgress } from '../../api/store.uts'

	// DLNA 投屏插件：电视自己拉流，手机只下发地址与控制指令
	import {
		CastDevice, CastResult, CastStatus, ScanOptions, CastOptions,
		scanDevices, scanDiagnostics, stopScan, connect, disconnect, isConnected, getConnectedName,
		play, pause, resume, stop, seek, setVolume, getStatus
	} from '@/uni_modules/uni-dlna-cast'

	const vod = ref<VodItem | null>(null)
	const vodName = ref('加载中…')
	const vodPic = ref('')
	const remark = ref('')
	const typeName = ref('')
	const sources = ref<Array<PlaySource>>(new Array<PlaySource>())
	const srcIdx = ref(0)
	const epIdx = ref(0)
	const playUrl = ref('')
	const playError = ref(false)
	const playErrMsg = ref('')
	let curPos = 0.0
	let curDur = 0.0
	let videoContext : VideoContext | null = null
	let apiBase = ''
	let vodId = ''
	let vodKey = ''
	let wantEp = 0
	let seekTo = -1.0
	let lastSave = 0
	let pendingSeek = false
	let autoSwitching = false   // 正在自动换线路中
	let triedSrc : string[] = [] // 本集已试过的线路标识
	let pageReady = false       // 页面渲染就绪标志
	let pendingUrl = ''         // 就绪前挂起的播放地址
	const statusBarH = ref(44)

	// ---------- 投屏状态 ----------
	const casting = ref(false)                                    // 投屏模式
	const castDevices = ref<Array<CastDevice>>(new Array<CastDevice>())
	const castStatus = ref<CastStatus | null>(null)
	const showCastPanel = ref(false)                               // 设备选择弹层
	const scanning = ref(false)                                    // 扫描中
	const scanDiag = ref('')                                       // 扫描诊断（搜不到时展示）
	const scanHint = ref('请确认手机与电视连接同一 Wi-Fi，且路由器未开启 AP 隔离')
	const castDeviceName = ref('')                                 // 当前投屏设备名
	const connecting = ref(false)                                  // 连接设备中
	const castPlayed = ref(false)                                  // 是否已开始播放（用于识别真播完）
	const castSliderPos = ref(0)                                   // 投屏进度（秒）
	const castDur = ref(0)                                         // 投屏总时长（秒）
	const castVolume = ref(50)                                     // 投屏音量 0-100
	let castTimer = -1                   // 状态轮询定时器
	let castProgressDragging = false     // 进度条拖动中（拖动期间不被轮询覆盖）
	let castVolumeDragging = false       // 音量条拖动中

	const episodes = computed((): Array<Episode> => {
		const v = vod.value
		if (v == null) return new Array<Episode>()
		if (srcIdx.value >= v.sources.length) return new Array<Episode>()
		return v.sources[srcIdx.value].episodes
	})

	const curEpName = computed((): string => {
		const eps = episodes.value
		if (eps.length == 0) return ''
		return eps[epIdx.value].name
	})

	const curSrcLabel = computed((): string => {
		const v = vod.value
		if (v == null || v.sources.length == 0) return ''
		return v.sources[srcIdx.value].label
	})

	// ---------- 投屏展示用计算属性 ----------
	const padTime = (n : number) : string => {
		const i = Math.floor(n)
		return i < 10 ? `0${i}` : i.toString()
	}

	const formatTime = (sec : number) : string => {
		let s = Math.floor(sec)
		if (s < 0) s = 0
		const h = Math.floor(s / 3600)
		const m = Math.floor((s % 3600) / 60)
		const ss = s % 60
		if (h > 0) return `${h}:${padTime(m)}:${padTime(ss)}`
		return `${padTime(m)}:${padTime(ss)}`
	}

	const castPlayLabel = computed((): string => {
		const st = castStatus.value
		if (st != null && st.state == 'PLAYING') return '暂停'
		return '播放'
	})

	// 进度条上限：时长未知时给一个宽松上限，保证仍可拖动 seek
	const castSliderMax = computed((): number => {
		const dur = Math.floor(castDur.value)
		return dur > 1 ? dur : 7200
	})

	const castProgressText = computed((): string => {
		return `${formatTime(castSliderPos.value)} / ${formatTime(castDur.value)}`
	})

	// 播完判定：STOPPED 且（本集真的播过 或 进度已到尾）
	// 刚投屏时电视可能先回 STOPPED，用 castPlayed/进度兜底避免误报
	const castEnded = computed((): boolean => {
		if (!casting.value) return false
		const st = castStatus.value
		if (st == null || st.state != 'STOPPED') return false
		if (castPlayed.value) return true
		return st.duration > 0 && st.position >= st.duration - 5
	})

	onLoad((options : OnLoadOptions) => {
		apiBase = decodeURIComponent(options['api'] ?? '')
		vodId = options['id'] ?? ''
		wantEp = Number(options['ep'] ?? '0')
		const s = options['src'] ?? '0'
		srcIdx.value = Number(s)
		vodKey = `${apiBase}|${vodId}`
		statusBarH.value = uni.getWindowInfo().statusBarHeight
		loadData()
	})

	onReady(() => {
		pageReady = true
		// 网络回调先于页面就绪时，挂起的地址在此应用
		if (pendingUrl.length > 0) {
			const u = pendingUrl
			pendingUrl = ''
			applyUrl(u)
		}
	})

	onUnload(() => {
		// 页面退出：停扫描、停轮询。不断开设备——电视继续播放，手机侧随时可以关闭
		stopScan()
		stopCastTimer()
	})

	// 懒创建视频上下文：video 组件由 v-if 控制，挂载时机晚于 onReady
	const ensureContext = () => {
		if (videoContext == null) {
			videoContext = uni.createVideoContext('player')
		}
	}

	const applyUrl = (url : string) => {
		playUrl.value = url
		playError.value = false
		playErrMsg.value = ''
		recordHistory(url)
		// 视频组件随 v-if 挂载后创建上下文并显式起播（部分设备 autoplay 不生效）
		setTimeout(() => {
			ensureContext()
			if (!playError.value) {
				videoContext!.play()
			}
		}, 400)
	}

	const loadData = () => {
		fetchVod(apiBase, `ids=${vodId}`, true, (res) => {
			if (res.code != 0 || res.list.length == 0) {
				vodName.value = '加载失败'
				playError.value = true
				return
			}
			const v = res.list[0]
			vod.value = v
			vodName.value = v.name
			vodPic.value = v.pic
			remark.value = v.remark
			typeName.value = v.typeName
			if (srcIdx.value >= v.sources.length) srcIdx.value = 0
			if (wantEp >= episodes.value.length) wantEp = 0
			epIdx.value = wantEp
			startPlay(wantEp, true)
		})
	}

	const startPlay = (ep : number, fromProgress : boolean) => {
		const v = vod.value
		if (v == null || v.sources.length == 0) return
		const eps = v.sources[srcIdx.value].episodes
		if (ep >= eps.length) return
		epIdx.value = ep
		seekTo = -1.0
		let url = eps[ep].url
		if (fromProgress) {
			const p = getProgress(vodKey, ep)
			if (p != null && p.position > 30 && (p.duration <= 0 || p.position < p.duration - 60)) {
				seekTo = p.position
			}
		}
		// 同一地址重试时加时间戳强制重载（不采用清空src的方式，避免原生播放器快速重建引发崩溃）
		if (url == playUrl.value) {
			url = url + (url.indexOf('?') > 0 ? '&' : '?') + '_r=' + Date.now().toString()
		}
		if (!pageReady) {
			pendingUrl = url   // 页面未就绪：等 onReady 再挂载视频，规避早赋值竞态
			return
		}
		applyUrl(url)
	}

	const recordHistory = (epUrl : string) => {
		const v = vod.value
		if (v == null) return
		const eps = v.sources[srcIdx.value].episodes
		const item = new HistoryItem()
		item.key = vodKey
		item.vodId = vodId
		item.sourceApi = apiBase
		item.name = v.name
		item.pic = v.pic
		item.episodeIndex = epIdx.value
		item.episodeName = eps[epIdx.value].name
		item.episodeUrl = epUrl
		item.flag = v.sources[srcIdx.value].flag
		item.playMode = 'vod'
		item.updateTime = Date.now()
		pushHistory(item)
	}

	const onLoaded = (_ : UniVideoLoadedMetadataEvent) => {
		// 元数据加载后跳转续播位置
		if (seekTo > 0) {
			ensureContext()
			pendingSeek = true
			videoContext!.seek(Number(seekTo))
			seekTo = -1.0
		}
	}

	const onPlay = (_ : UniEvent) => {
		// 播放成功：结束自动换线状态；当前线路视为可用，清空试线记录
		autoSwitching = false
		triedSrc = []
		// 投屏中本地不允许出声：误触起播则立即按下暂停（不销毁组件）
		if (casting.value && videoContext != null) {
			videoContext!.pause()
		}
	}

	const onTimeUpdate = (e : UniVideoTimeUpdateEvent) => {
		curPos = e.detail.currentTime
		curDur = e.detail.duration
		// 跳转期间不保存，避免把片头位置写进记录
		if (pendingSeek) {
			if (e.detail.currentTime > 5) pendingSeek = false
			return
		}
		const now = Date.now()
		// 每5秒保存一次进度
		if (now - lastSave > 5000) {
			lastSave = now
			saveProgress(vodKey, epIdx.value, e.detail.currentTime, e.detail.duration)
		}
	}

	const onEnded = (_ : UniEvent) => {
		// 假ended防护：流异常中断时 currentTime 远小于 duration，此时按错误处理，
		// 否则会疯狂循环"自动下一集"导致页面被冲垮
		if (curDur > 0 && curPos < curDur - 20) {
			handlePlayFailure('播放流中断')
			return
		}
		// 真正播完：自动连播下一集
		const eps = episodes.value
		if (epIdx.value + 1 < eps.length) {
			uni.showToast({ title: '自动播放下一集', icon: 'none' })
			startPlay(epIdx.value + 1, false)
		}
	}

	const onError = (e : UniVideoErrorEvent) => {
		handlePlayFailure(`错误码${e.detail.errCode}`)
	}

	// 统一的播放失败处理：记录原因 → 自动换线 → 全部失败则展示错误卡片
	const handlePlayFailure = (reason : string) => {
		playErrMsg.value = reason
		const v = vod.value
		if (v == null || v.sources.length <= 1) {
			playError.value = true
			return
		}
		const curFlag = v.sources[srcIdx.value].flag
		if (triedSrc.indexOf(curFlag) < 0) triedSrc.push(curFlag)
		const next = findNextSource()
		if (next < 0) {
			// 所有线路都试过了
			autoSwitching = false
			playError.value = true
			uni.showToast({ title: '所有线路均播放失败，请稍后重试', icon: 'none' })
			return
		}
		autoSwitching = true
		uni.showToast({ title: `「${v.sources[srcIdx.value].label}」失败，切换到${v.sources[next].label}`, icon: 'none' })
		srcIdx.value = next
		startPlay(epIdx.value, false)
	}

	// 找一条没试过的线路，返回索引；没有返回 -1
	const findNextSource = () : number => {
		const v = vod.value
		if (v == null) return -1
		for (let i = 0; i < v.sources.length; i++) {
			if (i == srcIdx.value) continue
			if (triedSrc.indexOf(v.sources[i].flag) < 0) return i
		}
		return -1
	}

	const switchEp = (i : number) => {
		// 手动切集：重置自动换线记录
		triedSrc = []
		autoSwitching = false
		// 投屏中切集：直接让电视拉新地址，本地播放器保持暂停
		if (casting.value) {
			castSwitchEp(i)
			return
		}
		startPlay(i, true)
	}

	const switchSource = (i : number) => {
		const v = vod.value
		if (v == null) return
		// 手动换线路：重置自动换线记录
		triedSrc = []
		autoSwitching = false
		srcIdx.value = i
		// 换线路后尽量保持同一集
		const ep = epIdx.value < v.sources[i].episodes.length ? epIdx.value : 0
		if (casting.value) {
			castSwitchEp(ep)
			return
		}
		startPlay(ep, false)
	}

	const switchNextSource = () => {
		const v = vod.value
		if (v == null || v.sources.length <= 1) return
		triedSrc = []
		autoSwitching = false
		const next = (srcIdx.value + 1) % v.sources.length
		switchSource(next)
	}

	const goBack = () => {
		uni.navigateBack()
	}

	// ==================== 投屏 ====================

	const castFailToast = (res : CastResult) => {
		const msg = res.errMsg.length > 0 ? res.errMsg : '投屏操作失败'
		uni.showToast({ title: msg, icon: 'none' })
	}

	// 统一的控制结果处理：errCode 非 0 时弹提示
	const castOpts = () : CastOptions => {
		return {
			success: (r : CastResult) => {
				if (r.errCode != 0) castFailToast(r)
			},
			fail: (r : CastResult) => {
				castFailToast(r)
			}
		} as CastOptions
	}

	// 打开设备选择弹层并开始扫描
	const openCastPanel = () => {
		showCastPanel.value = true
		startScan()
	}

	// 关闭弹层：停止扫描释放组播锁
	const closeCastPanel = () => {
		showCastPanel.value = false
		connecting.value = false
		scanning.value = false
		stopScan()
	}

	const startScan = () => {
		stopScan()
		scanning.value = true
		scanDiag.value = ''
		scanHint.value = '请确认手机与电视连接同一 Wi-Fi，且路由器未开启 AP 隔离'
		castDevices.value = new Array<CastDevice>()
		const opts = {
			// 6 秒：真机首次组播要等网卡唤醒，设备也在 MX 秒内随机延迟响应，4 秒偏紧
			timeout: 6000,
			success: (devices : Array<CastDevice>) => {
				scanning.value = false
				castDevices.value = devices
				if (devices.length == 0) explainEmptyScan()
			},
			fail: (res : CastResult) => {
				scanning.value = false
				castDevices.value = new Array<CastDevice>()
				scanDiag.value = res.errMsg
				castFailToast(res)
			},
			complete: () => {
				scanning.value = false
			}
		} as ScanOptions
		scanDevices(opts)
	}

	// 搜不到设备时，根据底层诊断给出可操作的原因，而不是只甩一句"未找到"
	const explainEmptyScan = () => {
		let diag = ''
		try {
			diag = scanDiagnostics()
		} catch (e : any) {
			diag = ''
		}
		scanDiag.value = diag
		if (diag.indexOf('iface=none') >= 0) {
			scanHint.value = '当前没有可用的局域网连接。请确认手机已连上 Wi-Fi（不是仅蜂窝网络）'
		} else if (diag.indexOf('packets=0') >= 0) {
			scanHint.value = '没有收到任何局域网响应：多半是路由器开启了 AP 隔离，或手机连的是访客网络。也可把电视的「投屏/DLNA」开关打开后重试'
		} else if (diag.indexOf('candidates=') >= 0) {
			scanHint.value = '收到了设备响应但都无法连接：可能是电视端 DLNA 服务异常，重启电视后再试'
		}
	}

	// 点诊断信息复制，方便反馈
	const copyDiag = () => {
		if (scanDiag.value.length == 0) return
		uni.setClipboardData({
			data: scanDiag.value,
			success: () => {
				uni.showToast({ title: '诊断信息已复制', icon: 'none' })
			}
		})
	}

	// 选设备 → connect → play → 关闭弹层 → 进入投屏模式
	const pickDevice = (d : CastDevice) => {
		if (connecting.value) return
		if (playUrl.value.length == 0) {
			uni.showToast({ title: '视频地址还没准备好，请稍后再试', icon: 'none' })
			return
		}
		connecting.value = true
		const onFail = (r : CastResult) => {
			connecting.value = false
			castFailToast(r)
		}
		connect(d, {
			success: (r : CastResult) => {
				if (r.errCode != 0) {
					onFail(r)
					return
				}
				if (!isConnected()) {
					connecting.value = false
					uni.showToast({ title: '连接设备失败，请重试', icon: 'none' })
					return
				}
				const n = getConnectedName()
				startCastPlayback(n.length > 0 ? n : d.name)
			},
			fail: (r : CastResult) => {
				onFail(r)
			}
		} as CastOptions)
	}

	const startCastPlayback = (deviceName : string) => {
		play(playUrl.value, vodName.value, {
			success: (r : CastResult) => {
				connecting.value = false
				if (r.errCode != 0) {
					castFailToast(r)
					return
				}
				closeCastPanel()
				enterCastMode(deviceName)
				uni.showToast({ title: `已投屏到${deviceName}`, icon: 'none' })
			},
			fail: (r : CastResult) => {
				connecting.value = false
				castFailToast(r)
			}
		} as CastOptions)
	}

	// 进入投屏模式：本地视频暂停但保留组件，启动状态轮询
	const enterCastMode = (deviceName : string) => {
		casting.value = true
		castDeviceName.value = deviceName
		castStatus.value = null
		castPlayed.value = false
		castSliderPos.value = 0
		castDur.value = 0
		castProgressDragging = false
		castVolumeDragging = false
		if (playUrl.value.length > 0) {
			ensureContext()
			videoContext!.pause()
		}
		startCastTimer()
		refreshCastStatus()
	}

	const startCastTimer = () => {
		stopCastTimer()
		castTimer = setInterval(() => {
			refreshCastStatus()
		}, 3000)
	}

	const stopCastTimer = () => {
		if (castTimer >= 0) {
			clearInterval(castTimer)
			castTimer = -1
		}
	}

	// 每 3 秒从电视拉一次播放状态
	const refreshCastStatus = () => {
		if (!casting.value) return
		getStatus((status : CastStatus) => {
			castStatus.value = status
			if (status.state == 'PLAYING') castPlayed.value = true
			// UNKNOWN 表示这次读取失败（位置/音量为兜底0），保留上一次的数值
			if (status.state == 'UNKNOWN') return
			if (!castProgressDragging) castSliderPos.value = status.position
			if (status.duration > 0) {
				castDur.value = status.duration
			} else if (curDur > 0 && castDur.value <= 0) {
				castDur.value = curDur   // 电视没给时长时用本地元数据兜底
			}
			if (!castVolumeDragging) castVolume.value = Math.floor(status.volume)
		})
	}

	// 暂停 / 继续播放：按当前 status.state 决定动作
	const castTogglePlay = () => {
		if (!casting.value) return
		const st = castStatus.value
		const playing = st != null && st.state == 'PLAYING'
		const opts = castOpts()
		if (playing) {
			pause(opts)
		} else {
			resume(opts)
		}
		setTimeout(() => {
			refreshCastStatus()
		}, 800)
	}

	const castSeekTo = (sec : number) => {
		seek(sec, castOpts())
	}

	// 快退 / 快进 10 秒
	const castSeekBy = (delta : number) => {
		if (!casting.value) return
		let target = castSliderPos.value + delta
		if (target < 0) target = 0
		// 时长未知（仍为0）时不设上限，避免被夹到1秒
		if (castDur.value > 1 && target > castDur.value) target = Math.floor(castDur.value)
		castSliderPos.value = target
		castSeekTo(target)
	}

	const castSeekBack = () => {
		castSeekBy(0 - 10)
	}

	const castSeekForward = () => {
		castSeekBy(10)
	}

	const onCastProgressChanging = (e : UniSliderChangeEvent) => {
		castProgressDragging = true
		castSliderPos.value = e.detail.value
	}

	const onCastProgressChange = (e : UniSliderChangeEvent) => {
		castProgressDragging = false
		castSliderPos.value = e.detail.value
		castSeekTo(e.detail.value)
	}

	const onCastVolumeChanging = (e : UniSliderChangeEvent) => {
		castVolumeDragging = true
		castVolume.value = e.detail.value
	}

	const onCastVolumeChange = (e : UniSliderChangeEvent) => {
		castVolumeDragging = false
		castVolume.value = e.detail.value
		setVolume(e.detail.value, castOpts())
	}

	// 停止投屏：停电视播放 → 断开控制 → 恢复本地播放
	const stopCasting = () => {
		const pos = castSliderPos.value
		stop(castOpts())
		disconnect()
		casting.value = false
		castDeviceName.value = ''
		castStatus.value = null
		castPlayed.value = false
		castSliderPos.value = 0
		castDur.value = 0
		stopCastTimer()
		resumeLocalPlay(pos)
	}

	// 回到本地播放：投屏期间切过集/换过线路时按当前剧集重新加载
	const resumeLocalPlay = (pos : number) => {
		const eps = episodes.value
		let targetUrl = ''
		if (epIdx.value >= 0 && epIdx.value < eps.length) {
			targetUrl = eps[epIdx.value].url
		}
		if (targetUrl.length == 0 || playUrl.value.length == 0 || targetUrl != playUrl.value) {
			startPlay(epIdx.value, true)
			return
		}
		ensureContext()
		if (pos > 0) {
			videoContext!.seek(pos)
		}
		videoContext!.play()
	}

	// 投屏中切集：直接让电视拉新地址，不走本地播放器
	const castSwitchEp = (i : number) => {
		const eps = episodes.value
		if (i < 0 || i >= eps.length) return
		epIdx.value = i
		seekTo = -1.0
		castPlayed.value = false
		castStatus.value = null
		castSliderPos.value = 0
		castDur.value = 0
		const url = eps[i].url
		play(url, vodName.value, {
			success: (r : CastResult) => {
				if (r.errCode != 0) {
					castFailToast(r)
					return
				}
				recordHistory(url)
				refreshCastStatus()
			},
			fail: (r : CastResult) => {
				castFailToast(r)
			}
		} as CastOptions)
	}
</script>

